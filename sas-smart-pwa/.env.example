# SAS Smart sunucusu (login ekranındaki "sunucu" alanı; sadece IP / alan adı)
SAS_HOST=88.247.51.116
SAS_PORT=8081

# SAS servisinin beklediği sabit header değerleri (tarayıcıya gönderilmez)
SAS_USERNAME=root
SAS_PASSWD=1234

# Bu uygulamanın dinleyeceği port
PORT=3000

# HTTPS sonlandıran bir reverse proxy (nginx, Caddy, Render, Railway...) arkasındaysa 1 yapın
# TRUST_PROXY=1

# Oturum süresi (saat) ve SAS istek zaman aşımı (ms)
# SESSION_HOURS=12
# SAS_TIMEOUT_MS=8000

# Gerçek sunucu olmadan demo verisiyle çalıştırmak için (giriş: demo / demo / demo)
# SAS_MOCK=1
