# NetCHIEF Smart POS ayarları — bu dosyayı "pos.env" adıyla exe'nin yanına koyun.
# Orijinal programın config.ini dosyası exe'nin yanındaysa sunucu adresi, veritabanı adı, kullanıcı,
# işletme adı, yazıcı adları (CheckPrn, pack_prn...) ve StartTime oradan okunur; burada yalnızca eksikleri yazın.

# MySQL şifresi (config.ini içinde yoktur)
POS_DB_PASSWORD=
# config.ini yoksa:
# POS_DB_HOST=192.168.1.251
# POS_DB_PORT=3306
# POS_DB_NAME=netchief
# POS_DB_USER=root
# POS_RESTAURANT=KEBAPÇI YALÇIN

# Yazıcılar: üründeki yazıcı adı (prn) → ağ yazıcısının adresi (ESC/POS, port 9100)
# POS_PRINTERS={"KEBAP":"192.168.1.60","BAR":"192.168.1.61","MUTFAK":"192.168.1.62:9100"}

# Programın portu, tam ekran (kiosk) açılış, hareketsizlikte kilit (ms)
# POS_PORT=3100
# POS_KIOSK=1
# POS_LOCK_TIMEOUT_MS=60000

# Gerçek veritabanı olmadan örnek veriyle denemek için
# POS_DEMO=1
