# SAS Smart sunucusu (sadece IP / alan adı, örn. 192.168.1.10) — kendi sunucunuzun adresini yazın
SAS_HOST=
SAS_PORT=8081

# SAS servisinin beklediği sabit header değerleri (tarayıcıya gönderilmez)
SAS_USERNAME=
SAS_PASSWD=

# Bu uygulamanın dinleyeceği port
PORT=3000

# Telefona kurulum ("Yükle") için yerel HTTPS: sunucu PORT+1'de kendi sertifikasıyla HTTPS de dinler.
# Adımlar: telefonda http://<sunucu-ip>:<PORT>/kurulum   ·   Kapatmak için HTTPS_PORT=0
# HTTPS_PORT=3001
# Sertifikaya eklenecek ek adresler (sunucunun IP'leri kendiliğinden eklenir)
# HTTPS_HOSTS=192.168.1.251

# HTTPS sonlandıran bir reverse proxy (nginx, Caddy, Render, Railway...) arkasındaysa 1 yapın
# TRUST_PROXY=1

# Oturum süresi (saat) ve SAS istek zaman aşımı (ms)
# SESSION_HOURS=12
# SAS_TIMEOUT_MS=8000

# Gerçek sunucu olmadan demo verisiyle çalıştırmak için (giriş: demo / demo / demo)
# SAS_MOCK=1


# Bahçe sayılacak masa numaraları (Salon bölümünden ayrılır). Boş bırakılırsa ayrım yapılmaz.
SAS_BAHCE_TABLES=1-15,51

# Raporları görebilen en yüksek yetki seviyesi (orijinal uygulamada 14 altı görür)
# SAS_REPORT_MAX_AUTH=13

# Giriş ekranında seçilebilecek kullanıcı adları (virgülle). Girişte yalnızca şifre yazılır.
# Not: bu adlar giriş sayfasını açan herkese görünür.
# SAS_LOGIN_USERS=Yalçın,Ahmet

# Her bölümdeki masa sayısı. SAS yalnızca açık masaları gönderir; boş masalar 1..N olarak çizilir.
# SAS_TABLE_COUNT=72
